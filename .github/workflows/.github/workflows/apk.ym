/* Fi.OS · Servidor intermedio de Fia (Cloudflare Worker)
   La clave de Gemini vive AQUÍ como secreto, nunca en la web ni en GitHub.
   Secretos:   GEMINI_API_KEY (obligatorio) · GEMINI_API_KEY_PRO (opcional, para FiFi Ultra)
   Variable:   ALLOWED_ORIGIN = https://TU-USUARIO.github.io   (varios: separados por coma)
   Opcional:   DAILY_CAP = máximo de consultas por día (por defecto 1500) */
const MODELS=['gemini-3.5-flash','gemini-3.6-flash','gemini-3.5-flash-lite','gemini-2.5-flash-lite','gemini-3.7-flash','gemini-3.8-flash'];
const PRO=['gemini-3.5-pro','gemini-3.6-pro'];
const EXS=['neutral','happy','wink','think','concern','surprise'];
const hits=new Map();let day='',total=0;
const json=(o,s,c)=>new Response(JSON.stringify(o),{status:s,headers:{...c,'Content-Type':'application/json'}});
function sysP(ul,lang,ctx){return 'Eres '+(ul?'FiFi Ultra, la versión avanzada de Fia,':'Fia,')+' asistente financiera de la app Fi.OS (demo con datos ficticios). Responde en '+(lang=='en'?'inglés':'español')+', cálida y breve (máx. '+(ul?110:60)+' palabras), sin markdown. NUNCA ejecutas ni afirmas haber ejecutado movimientos de dinero: solo PROPONES acciones que el usuario autorizará aparte. Devuelve SOLO JSON: {"reply":string,"expression":"neutral|happy|wink|think|concern|surprise","actions":[{"t":"aho","a":monto,"i":indice_meta}|{"t":"rec","a":monto,"i":indice_meta,"d":dia_del_mes_1_a_31}|{"t":"tra","a":monto,"f":"ef|em|inv","to":"em|inv|de"}'+(ul?'|{"t":"inv","a":monto}':'')+']}. Usa expression concern ante riesgos o negativas, happy o wink en saludos y buenas noticias, think ante dudas, surprise ante cifras enormes. El indice 0 es el fondo de emergencia. '+(ul?'Puedes proponer inversiones SIMULADAS ({"t":"inv"}) solo con el fondo de emergencia completo y hasta el 30% del efectivo disponible; arma un plan breve y estructurado, resume noticias de mercado actuales (con fuente y fecha, usando búsqueda) y nunca prometas rendimientos. ':'No des asesoría de inversión específica ni garantías. ')+'Datos del usuario: '+ctx}
const parse=t=>{try{return JSON.parse(t)}catch(e){return JSON.parse(t.slice(t.indexOf('{'),t.lastIndexOf('}')+1))}};
export default{async fetch(req,env){
 const origin=req.headers.get('Origin')||'',allow=(env.ALLOWED_ORIGIN||'').split(',').map(x=>x.trim()).filter(Boolean);
 const cors={'Access-Control-Allow-Origin':allow.includes(origin)?origin:(allow[0]||'null'),'Access-Control-Allow-Methods':'POST,OPTIONS','Access-Control-Allow-Headers':'Content-Type','Vary':'Origin'};
 if(req.method=='OPTIONS')return new Response(null,{status:204,headers:cors});
 if(req.method!='POST'||!allow.includes(origin))return json({error:'forbidden'},403,cors);
 if(!env.GEMINI_API_KEY)return json({error:'not_configured'},500,cors);
 const today=new Date().toISOString().slice(0,10);if(day!=today){day=today;total=0}
 if(total>=Number(env.DAILY_CAP||1500))return json({error:'daily_cap'},429,cors);
 const ip=req.headers.get('CF-Connecting-IP')||'x',now=Date.now(),h=(hits.get(ip)||[]).filter(t=>now-t<6e4);
 if(h.length>=12)return json({error:'rate'},429,cors);h.push(now);hits.set(ip,h);total++;
 let b;try{b=await req.json()}catch(e){return json({error:'bad_request'},400,cors)}
 const q=String(b.q||'').slice(0,500);if(!q.trim())return json({error:'empty'},400,cors);
 const ul=b.ultra===true,lang=b.lang=='en'?'en':'es';let ctx='{}';try{ctx=JSON.stringify(b.ctx&&typeof b.ctx=='object'?b.ctx:{}).slice(0,2000)}catch(e){}
 const key=(ul&&env.GEMINI_API_KEY_PRO)||env.GEMINI_API_KEY,sys=sysP(ul,lang,ctx);let err='unavailable';
 for(const m of(ul?PRO.concat(MODELS):MODELS)){for(const tl of(ul&&PRO.includes(m)?[1,0]:[0])){try{
  const body={systemInstruction:{parts:[{text:sys}]},contents:[{role:'user',parts:[{text:q}]}],generationConfig:{temperature:.5,maxOutputTokens:ul?900:500}};
  if(tl)body.tools=[{google_search:{}}];else body.generationConfig.responseMimeType='application/json';
  const r=await fetch('https://generativelanguage.googleapis.com/v1beta/models/'+m+':generateContent',{method:'POST',headers:{'Content-Type':'application/json','x-goog-api-key':key},body:JSON.stringify(body)});
  if(r.status==401||r.status==403)return json({error:'upstream_auth'},502,cors);
  if(!r.ok){err='http_'+r.status;continue}
  const j=await r.json(),t=((((j.candidates||[])[0]||{}).content||{}).parts||[]).map(p=>p.text||'').join(''),o=parse(t);
  if(!o||typeof o.reply!='string'||!o.reply.trim()){err='format';continue}
  return json({reply:o.reply.trim().slice(0,900),expression:EXS.includes(o.expression)?o.expression:'neutral',actions:Array.isArray(o.actions)?o.actions.slice(0,6):[]},200,cors)}catch(e){err='error'}}}
 return json({error:err},502,cors)}};
